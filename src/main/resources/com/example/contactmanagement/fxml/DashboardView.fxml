<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../css/styles.css" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contactmanagement.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="page-header">
            <Label text="Dashboard" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" styleClass="search-box" prefWidth="300.0">
                <FontIcon iconLiteral="fas-search" iconSize="14"/>
                <TextField promptText="Search contacts..." HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button styleClass="btn-icon">
                <graphic><FontIcon iconLiteral="fas-bell" iconSize="16"/></graphic>
            </Button>
            <Button styleClass="btn-icon">
                <graphic><FontIcon iconLiteral="fas-moon" iconSize="16"/></graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="32.0" style="-fx-padding: 32;">
                <GridPane hgap="24.0" vgap="24.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <HBox styleClass="stat-card" GridPane.columnIndex="0" spacing="16.0" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon-container">
                            <FontIcon iconLiteral="fas-users" iconSize="20" style="-fx-fill: #00A86B;" />
                        </StackPane>
                        <VBox spacing="4.0">
                            <Label text="Total Contacts" styleClass="secondary-text"/>
                            <Label text="1,248" styleClass="page-title"/>
                        </VBox>
                    </HBox>
                    <HBox styleClass="stat-card" GridPane.columnIndex="1" spacing="16.0" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon-container" style="-fx-background-color: #FEF3C7;">
                            <FontIcon iconLiteral="fas-heart" iconSize="20" style="-fx-fill: #F59E0B;" />
                        </StackPane>
                        <VBox spacing="4.0">
                            <Label text="Favorites" styleClass="secondary-text"/>
                            <Label text="42" styleClass="page-title"/>
                        </VBox>
                    </HBox>
                    <HBox styleClass="stat-card" GridPane.columnIndex="2" spacing="16.0" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon-container" style="-fx-background-color: #E0E7FF;">
                            <FontIcon iconLiteral="fas-layer-group" iconSize="20" style="-fx-fill: #4F46E5;" />
                        </StackPane>
                        <VBox spacing="4.0">
                            <Label text="Groups" styleClass="secondary-text"/>
                            <Label text="8" styleClass="page-title"/>
                        </VBox>
                    </HBox>
                    <HBox styleClass="stat-card" GridPane.columnIndex="3" spacing="16.0" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon-container" style="-fx-background-color: #FCE7F3;">
                            <FontIcon iconLiteral="fas-clock" iconSize="20" style="-fx-fill: #DB2777;" />
                        </StackPane>
                        <VBox spacing="4.0">
                            <Label text="Recently Added" styleClass="secondary-text"/>
                            <Label text="14" styleClass="page-title"/>
                        </VBox>
                    </HBox>
                </GridPane>
                <VBox styleClass="card" spacing="16.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Recent Contacts" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="View All" styleClass="btn-secondary"/>
                    </HBox>
                    <TableView fx:id="recentContactsTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colName" text="Name" prefWidth="250.0"/>
                            <TableColumn fx:id="colPhone" text="Phone" prefWidth="150.0"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0"/>
                            <TableColumn fx:id="colCompany" text="Company" prefWidth="150.0"/>
                            <TableColumn text="Action" prefWidth="100.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
