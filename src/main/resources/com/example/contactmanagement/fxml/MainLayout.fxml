<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../css/styles.css" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contactmanagement.MainController" prefWidth="1280.0" prefHeight="720.0">
    <left>
        <VBox styleClass="sidebar" prefWidth="240.0" spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 24 0;">
                <FontIcon iconLiteral="fas-address-book" iconSize="24" style="-fx-fill: #00A86B;" />
                <Label text="Contacts" styleClass="section-title"/>
            </HBox>
            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" onAction="#showDashboard" text="Dashboard" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-home" iconSize="16"/></graphic>
                </Button>
                <Button fx:id="btnContacts" onAction="#showContacts" text="Contacts" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-users" iconSize="16"/></graphic>
                </Button>
                <Button fx:id="btnFavorites" onAction="#showFavorites" text="Favorites" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-heart" iconSize="16"/></graphic>
                </Button>
                <Button fx:id="btnGroups" onAction="#showGroups" text="Groups" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-layer-group" iconSize="16"/></graphic>
                </Button>
                <Button fx:id="btnRecent" onAction="#showRecent" text="Recent" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-clock" iconSize="16"/></graphic>
                </Button>
                <Button fx:id="btnTrash" onAction="#showTrash" text="Trash" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-trash" iconSize="16"/></graphic>
                </Button>
            </VBox>
            <VBox spacing="4.0">
                <Button fx:id="btnSettings" onAction="#showSettings" text="Settings" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-cog" iconSize="16"/></graphic>
                </Button>
                <Button fx:id="btnAbout" onAction="#showAbout" text="About" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-info-circle" iconSize="16"/></graphic>
                </Button>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 16 0 0 0;" styleClass="detail-footer">
                <Circle radius="16.0" style="-fx-fill: #D1D5DB;"/>
                <VBox>
                    <Label text="Ziyadul Islam" styleClass="body-text" style="-fx-font-weight: bold;"/>
                    <Label text="2024000010077@seu.edu.bd" styleClass="caption"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="btn-icon">
                    <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="14"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea"/>
    </center>
</BorderPane>
