<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox stylesheets="@../css/styles.css" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox>
            <Label text="Favorites" styleClass="page-title"/>
            <Label text="42 favorite contacts" styleClass="secondary-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" styleClass="search-box" prefWidth="250.0">
            <FontIcon iconLiteral="fas-search" iconSize="14" />
            <TextField promptText="Search favorites..." HBox.hgrow="ALWAYS"/>
        </HBox>
    </HBox>
    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <FlowPane hgap="24.0" vgap="24.0" style="-fx-padding: 32;" alignment="TOP_LEFT">
            <!-- Favorite Card -->
            <VBox styleClass="card" spacing="16.0" alignment="CENTER" prefWidth="220.0">
                <Circle radius="32.0" style="-fx-fill: #E5E7EB;"/>
                <VBox alignment="CENTER" spacing="4.0">
                    <Label text="Sadia Afrin" styleClass="section-title"/>
                    <Label text="Designer" styleClass="secondary-text"/>
                </VBox>
                <HBox alignment="CENTER" spacing="16.0">
                    <Button styleClass="btn-icon"><graphic><FontIcon iconLiteral="fas-phone" iconSize="14"/></graphic></Button>
                    <Button styleClass="btn-icon"><graphic><FontIcon iconLiteral="fas-envelope" iconSize="14"/></graphic></Button>
                    <FontIcon iconLiteral="fas-heart" iconSize="20" styleClass="badge-favorite"/>
                </HBox>
            </VBox>
            <!-- Favorite Card Copy -->
            <VBox styleClass="card" spacing="16.0" alignment="CENTER" prefWidth="220.0">
                <Circle radius="32.0" style="-fx-fill: #E5E7EB;"/>
                <VBox alignment="CENTER" spacing="4.0">
                    <Label text="Tanvir Rahman" styleClass="section-title"/>
                    <Label text="Data Scientist" styleClass="secondary-text"/>
                </VBox>
                <HBox alignment="CENTER" spacing="16.0">
                    <Button styleClass="btn-icon"><graphic><FontIcon iconLiteral="fas-phone" iconSize="14"/></graphic></Button>
                    <Button styleClass="btn-icon"><graphic><FontIcon iconLiteral="fas-envelope" iconSize="14"/></graphic></Button>
                    <FontIcon iconLiteral="fas-heart" iconSize="20" styleClass="badge-favorite"/>
                </HBox>
            </VBox>
        </FlowPane>
    </ScrollPane>
</VBox>
