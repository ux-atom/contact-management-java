<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<SplitPane stylesheets="@../css/styles.css" styleClass="root" dividerPositions="0.7" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contactmanagement.ContactsController">
    <VBox spacing="0">
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
            <VBox>
                <Label text="Contacts" styleClass="page-title"/>
                <Label text="1,248 total contacts" styleClass="secondary-text"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" styleClass="search-box" prefWidth="250.0">
                <FontIcon iconLiteral="fas-search" iconSize="14"/>
                <TextField promptText="Search..." HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button styleClass="btn-secondary">
                <graphic><FontIcon iconLiteral="fas-filter" iconSize="14"/></graphic>
            </Button>
            <Button text="Add Contact" styleClass="btn-primary">
                <graphic><FontIcon iconLiteral="fas-plus" iconSize="14"/></graphic>
            </Button>
        </HBox>
        <VBox style="-fx-padding: 24;" VBox.vgrow="ALWAYS">
            <TableView fx:id="contactsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" text="Name" prefWidth="250.0"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="150.0"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0"/>
                    <TableColumn fx:id="colGroup" text="Group" prefWidth="100.0"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
    
    <VBox styleClass="detail-panel">
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox spacing="24.0" style="-fx-padding: 32;" alignment="TOP_CENTER">
                <Circle radius="48.0" style="-fx-fill: #E5E7EB;"/>
                <VBox alignment="CENTER" spacing="8.0">
                    <Label text="Md. Rakib Hasan" styleClass="page-title"/>
                    <Label text="Software Engineer at Pathao" styleClass="secondary-text"/>
                    <HBox alignment="CENTER" spacing="8.0">
                        <Label text="Family" styleClass="badge-group"/>
                        <Label text="Favorite" styleClass="badge-group, badge-favorite"/>
                    </HBox>
                </VBox>
                <HBox alignment="CENTER" spacing="12.0">
                    <Button styleClass="btn-icon, btn-secondary"><graphic><FontIcon iconLiteral="fas-phone" iconSize="16"/></graphic></Button>
                    <Button styleClass="btn-icon, btn-secondary"><graphic><FontIcon iconLiteral="fas-envelope" iconSize="16"/></graphic></Button>
                    <Button styleClass="btn-icon, btn-secondary"><graphic><FontIcon iconLiteral="fas-star" iconSize="16"/></graphic></Button>
                    <Button styleClass="btn-icon, btn-secondary"><graphic><FontIcon iconLiteral="fas-ellipsis-h" iconSize="16"/></graphic></Button>
                </HBox>
                <VBox spacing="16.0" styleClass="card">
                    <Label text="Contact Information" styleClass="section-title"/>
                    <GridPane vgap="16.0" hgap="16.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="30"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <FontIcon iconLiteral="fas-phone-alt" iconSize="16" style="-fx-fill: #9CA3AF;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="+880 1711-223344" styleClass="body-text"/>
                            <Label text="Mobile" styleClass="caption"/>
                        </VBox>
                        
                        <FontIcon iconLiteral="fas-envelope" iconSize="16" style="-fx-fill: #9CA3AF;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="rakib.hasan@example.com" styleClass="body-text"/>
                            <Label text="Work" styleClass="caption"/>
                        </VBox>

                        <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16" style="-fx-fill: #9CA3AF;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="House 12, Road 5, Dhanmondi, Dhaka 1205" styleClass="body-text" wrapText="true"/>
                            <Label text="Home" styleClass="caption"/>
                        </VBox>
                    </GridPane>
                </VBox>
                <VBox spacing="16.0" styleClass="card">
                    <Label text="Notes" styleClass="section-title"/>
                    <Label text="Met at the JavaFX conference. Very interested in UI/UX design and modern desktop applications." styleClass="body-text" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="detail-footer">
            <Button text="Delete" styleClass="btn-danger"/>
            <Button text="Edit" styleClass="btn-primary"/>
        </HBox>
    </VBox>
</SplitPane>
